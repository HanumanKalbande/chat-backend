NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
LOG_LEVEL=info

# Matches docker-compose.yml in the repo root
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=laravel

FIREBASE_PROJECT_ID=chat-app-533a7

# Option A: real Firebase project - path to the service account key JSON
# (Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: Firestore emulator - uncomment; the key file is then not needed
# FIRESTORE_EMULATOR_HOST=localhost:8081
